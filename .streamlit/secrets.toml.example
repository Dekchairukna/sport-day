# คัดลอกไฟล์นี้เป็น .streamlit/secrets.toml (ห้ามอัปขึ้น GitHub)
# หรือใส่ค่าเดียวกันในหน้า Settings > Secrets ของ Streamlit Community Cloud

# รหัสผ่านเริ่มต้นของบัญชี admin ใช้ตอนสร้างบัญชีครั้งแรกเท่านั้น (ค่าเริ่มต้นคือ 1234)
# หลังจากนั้นเปลี่ยนรหัสผ่านได้ในแอป
edit_pin = "เปลี่ยนเป็นรหัสของโรงเรียน"

# ถ้าเปิดใช้ออนไลน์ ให้ใช้ฐานข้อมูล PostgreSQL ฟรี (เช่น Neon หรือ Supabase)
# ไม่ใส่ = ใช้ไฟล์ data/sportsday.db ในเครื่อง
# db_url = "postgresql://user:password@host/dbname"
